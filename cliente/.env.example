# URL del backend API (REQUERIDA)
VITE_API_URL=http://localhost:3000

# Configuración de Cloudinary (REQUERIDA para subir fotos de mascotas)
# 1. Crear cuenta en https://cloudinary.com
# 2. Copiar Cloud Name del dashboard
# 3. Settings > Upload > Upload presets > crear uno UNSIGNED
VITE_CLOUDINARY_CLOUD_NAME=tu_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=tu_upload_preset

# API Keys opcionales (sin key usa fallback local de razas)
# https://thedogapi.com  /  https://thecatapi.com
VITE_DOG_API_KEY=
VITE_CAT_API_KEY=
