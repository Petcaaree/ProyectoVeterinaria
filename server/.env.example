# ── Servidor ──────────────────────────────────────────────
PORT=3000
# NODE_ENV: development | production | test
NODE_ENV=development

# ── Base de datos ──────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/vet

# ── JWT ───────────────────────────────────────────────────
# IMPORTANTE: cambiar JWT_SECRET por una cadena aleatoria larga en produccion
# Ejemplo: openssl rand -base64 64
JWT_SECRET=petcare_dev_secret_cambiar_en_produccion
JWT_EXPIRES_IN=24h

# ── Refresh Tokens ────────────────────────────────────────
# Dias de validez del refresh token (default: 7)
REFRESH_TOKEN_EXPIRY_DAYS=7

# ── CORS ──────────────────────────────────────────────────
# Origins permitidos, separados por coma (sin espacios entre URLs)
# En produccion reemplazar con la URL real del frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Logging ──────────────────────────────────────────────
# Niveles: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=debug

# ── MercadoPago ───────────────────────────────────────────
# Obtener credenciales en https://www.mercadopago.com.ar/developers/panel
# Para sandbox: usar Access Token de prueba (comienza con TEST-)
MP_ACCESS_TOKEN=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Secret key del webhook (panel de MP → tu aplicación → Webhooks → "Clave secreta").
# Se usa para validar la firma HMAC-SHA256 de cada notificación entrante.
# Sin este valor, todos los webhooks son rechazados con HTTP 403.
MP_WEBHOOK_SECRET=cambiar_por_secret_del_panel_de_mp
# URL pública del backend (necesaria para el webhook de MP)
BACKEND_URL=http://localhost:3000
# URL pública del frontend (para los back_urls de MP)
FRONTEND_URL=http://localhost:5173

# ── SMTP / Email ──────────────────────────────────────────
# Credenciales SMTP para notificaciones transaccionales (pago confirmado, recordatorios, etc.).
# Si las variables SMTP_HOST/USER/PASS no están seteadas, los emails se loguean a consola (modo dev).
#
# ▸ Opción A — Gmail + App Password (recomendado para desarrollo/demos, 0 costo, ~500 emails/día)
#   1. Activar 2FA en tu cuenta Google.
#   2. Crear App Password en https://myaccount.google.com/apppasswords (16 caracteres sin espacios).
#   3. Usar los valores de abajo (reemplazar tu-cuenta@gmail.com y el app password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
EMAIL_FROM=PetConnect <tu-cuenta@gmail.com>
#
# ▸ Opción B — Resend (recomendado para producción, 3.000 emails/mes gratis, requiere verificar dominio)
#   1. Crear cuenta en https://resend.com y generar API key.
#   2. Reemplazar el bloque de arriba por:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=PetConnect <noreply@tudominio.com>

# ══════════════════════════════════════════════════════════
# PRODUCCION — Copiar a .env y ajustar valores
# ══════════════════════════════════════════════════════════
# NODE_ENV=production
# PORT=3000
# MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/petcare?retryWrites=true&w=majority
# JWT_SECRET=<generar con: openssl rand -base64 64>
# JWT_EXPIRES_IN=15m
# REFRESH_TOKEN_EXPIRY_DAYS=7
# CORS_ORIGINS=https://tudominio.com
# LOG_LEVEL=warn
